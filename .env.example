# Segredo para assinar as sessões (obrigatório em produção, mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Conta administrativa criada apenas na primeira inicialização (banco vazio).
# Se ADMIN_INITIAL_PASSWORD ficar vazio, uma senha aleatória é exibida no log do servidor.
ADMIN_EMAIL="coordenacao@novoamanhecer.org.br"
ADMIN_INITIAL_PASSWORD=""

# E-mail que recebe as notificações da coordenação (opcional).
COORDINATION_EMAIL=""

# Chave da API HTTP do Resend para envio real de e-mails (obrigatória para envio).
RESEND_API_KEY=""

# Remetente usado pela API do Resend (obrigatório para envio).
EMAIL_FROM=""


# "true" para popular beneficiários/voluntários/doações fictícios em produção (não recomendado).
SEED_DEMO_DATA=""

# Número de proxies à frente do servidor (padrão 1).
TRUST_PROXY=""

# GEMINI_API_KEY: usado pelo Google AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde o app está hospedado.
APP_URL="MY_APP_URL"
